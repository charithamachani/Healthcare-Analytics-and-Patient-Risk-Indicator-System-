# Copy this file to ".env" and edit. NEVER commit ".env" to Git.
DATABASE_URL=mysql+pymysql://health_user:CHANGE_ME@localhost:3306/health_analytics

# Format: role=key,role=key   (roles: analyst = read-only, admin = read + write)
# Generate long random keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=analyst=PUT_A_LONG_RANDOM_KEY_HERE,admin=PUT_A_DIFFERENT_LONG_RANDOM_KEY_HERE
